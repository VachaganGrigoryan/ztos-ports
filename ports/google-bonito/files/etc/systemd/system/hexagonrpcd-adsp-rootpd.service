[Unit]
Description=FastRPC server for the Qualcomm ADSP (rootpd)
Conflicts=suspend.target
Before=suspend.target
ConditionPathExists=/dev/fastrpc-adsp

[Service]
ExecStart=/usr/local/bin/hexagonrpcd -f /dev/fastrpc-adsp -d adsp
Restart=always
RestartSec=3
User=fastrpc
Group=fastrpc

[Install]
WantedBy=multi-user.target
