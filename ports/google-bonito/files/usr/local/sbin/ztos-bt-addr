#!/bin/sh
# Mainline WCN3990 has no public BD address; derive a stable, locally-administered one from the board serial.
serial=$(tr " " "\n" < /proc/cmdline | sed -n "s/^androidboot.serialno=//p")
[ -n "$serial" ] || serial=$(cat /etc/machine-id)
h=$(printf "%s-bt" "$serial" | sha256sum | cut -c1-10)
addr=$(printf "02:%s:%s:%s:%s:%s" $(echo "$h" | sed "s/../& /g"))
# hci0 shows up before its firmware setup finishes; until then mgmt says "Invalid Index"
for _ in $(seq 20); do
	btmgmt --index 0 power off >/dev/null 2>&1
	btmgmt --index 0 public-addr "$addr" && exit 0
	sleep 1
done
exit 1
