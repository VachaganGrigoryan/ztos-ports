+		}
+	}
+	int frames = 0;
+	for (;;) {
+		ssize_t n = read(fd, src.acc + src.acc_fill, frame - src.acc_fill);
+		if (n > 0) {
+			src.acc_fill += (size_t)n;
+			if (src.acc_fill == frame) {
