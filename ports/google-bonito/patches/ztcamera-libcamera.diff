+static int pipe_drain(int fd) {
+	size_t frame = (size_t)pipe_w * pipe_h * 4;
+	if (src.acc_size < frame) {
+		free(src.acc);
+		src.acc = malloc(frame);
+		src.acc_size = src.acc ? frame : 0;
+		src.acc_fill = 0;
+		if (!src.acc) {
